{
  "name": "pyprice",
  "version": "1.4.0",
  "description": "Unified Quick-Commerce Intelligence Engine and Unofficial API Suite for Zepto, Swiggy Instamart, Blinkit, BigBasket (bbnow), and JioMart",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start:zepto": "node zepto/src/server.js",
    "start:instamart": "node instamart/src/server.js",
    "start:blinkit": "node blinkit/src/server.js",
    "start:bigbasket": "node bigbasket/src/server.js",
    "start:jiomart": "node jiomart/src/server.js",
    "test:zepto": "node zepto/test/test_endpoints.js",
    "test:instamart": "node instamart/test/test_endpoints.js",
    "test:blinkit": "node blinkit/test/test_endpoints.js",
    "test:bigbasket": "node bigbasket/test/test_endpoints.js",
    "test:jiomart": "node jiomart/test/test_endpoints.js",
    "bench:zepto": "node zepto/test/bulk_test.js",
    "bench:instamart": "node instamart/test/bulk_test.js",
    "bench:blinkit": "node blinkit/test/bulk_test.js",
    "bench:bigbasket": "node bigbasket/test/bulk_test.js",
    "bench:jiomart": "node jiomart/test/bulk_test.js",
    "test": "npm run test:zepto && npm run test:instamart && npm run test:blinkit && npm run test:bigbasket && npm run test:jiomart"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  }
}
